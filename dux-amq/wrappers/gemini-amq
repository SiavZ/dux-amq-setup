#!/usr/bin/env bash
# gemini-amq: launch Gemini CLI with AMQ co-op identity (worktree-scoped).
# Skips AMQ wrapping for oneshot (-p / --print) invocations.
# Uses globally locked store/session ownership at $AMQ_GLOBAL_ROOT.
set -euo pipefail

STATE_ROOT="${STATE_ROOT:-/data/state}"

version_at_least() {
  local actual="$1" minimum="$2"
  local a_major a_minor a_patch m_major m_minor m_patch
  IFS=. read -r a_major a_minor a_patch <<<"$actual"
  IFS=. read -r m_major m_minor m_patch <<<"$minimum"
  [[ "$a_major" =~ ^[0-9]+$ && "$a_minor" =~ ^[0-9]+$ && "$a_patch" =~ ^[0-9]+$ ]] || return 1
  (( 10#$a_major > 10#$m_major )) ||
    (( 10#$a_major == 10#$m_major && 10#$a_minor > 10#$m_minor )) ||
    (( 10#$a_major == 10#$m_major && 10#$a_minor == 10#$m_minor && 10#$a_patch >= 10#$m_patch ))
}

require_provider_version() {
  local provider="$1" minimum="$2" output actual
  if ! command -v "$provider" >/dev/null 2>&1; then
    printf '%s-amq: %s is not installed or not on PATH\n' "$provider" "$provider" >&2
    exit 1
  fi
  output=$("$provider" --version 2>&1 || true)
  actual=$(printf '%s\n' "$output" | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
  if [[ -z "$actual" ]]; then
    printf '%s-amq: refusing %s because its version could not be parsed from %q; minimum supported is %s\n' \
      "$provider" "$provider" "$output" "$minimum" >&2
    exit 1
  fi
  if ! version_at_least "$actual" "$minimum"; then
    printf '%s-amq: refusing vulnerable %s %s; upgrade to >= %s\n' \
      "$provider" "$provider" "$actual" "$minimum" >&2
    exit 1
  fi
}

require_provider_version gemini 0.39.1

# See claude-amq for the full rationale on path-segment vs prefix
# containment (audit01 P0-5). `realpath --` requires GNU coreutils;
# install.sh preflights it.
is_dux_worktree() {
  local pwd_real worktrees_real
  pwd_real=$(realpath -- "$PWD" 2>/dev/null)        || return 1
  worktrees_real=$(realpath -- "${DUX_HOME:-$STATE_ROOT/dux}/worktrees" 2>/dev/null) || return 1
  case "$pwd_real/" in
    "$worktrees_real"/*) return 0 ;;
    *)                   return 1 ;;
  esac
}

for arg in "$@"; do
  case "$arg" in
    -p|--print) exec gemini "$@" ;;
  esac
done

if [[ -n "${DUX_STORE_ID:-}" || -n "${DUX_SESSION_ID:-}" || -n "${DUX_AMQ_HANDLE:-}" ]]; then
  if [[ -z "${DUX_STORE_ID:-}" || -z "${DUX_SESSION_ID:-}" || -z "${DUX_AMQ_HANDLE:-}" ]]; then
    printf 'gemini-amq: DUX_STORE_ID, DUX_SESSION_ID, and DUX_AMQ_HANDLE must be set together\n' >&2
    exit 1
  fi
  ME="$DUX_AMQ_HANDLE"
  MANAGED_IDENTITY=1
else
  ME="${AM_ME:-}"
  MANAGED_IDENTITY=0
fi
if [[ -z "$ME" ]] && is_dux_worktree; then
  ME=$(basename "$PWD")
fi
if [[ -z "$ME" ]]; then
  ME=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
fi
[[ -z "$ME" ]] && ME="gemini-$$"
if (( MANAGED_IDENTITY == 0 )); then
  ME=$(printf '%s' "$ME" | tr '[:upper:]' '[:lower:]' | sed 's|[^a-z0-9_-]|-|g; s|^-\+||; s|-\+$||')
fi
if [[ -z "$ME" || ${#ME} -gt 64 || ! "$ME" =~ ^[a-z0-9_-]+$ ]]; then
  printf 'gemini-amq: refusing invalid or overlong AMQ handle\n' >&2
  exit 1
fi

# Export AM_ME so descendants of `amq wake` (notably the inject-bridge)
# can identify the receiver. See claude-amq for full rationale.
export AM_ME="$ME"

ROOT="${AMQ_GLOBAL_ROOT:-$STATE_ROOT/amq}"
export AM_ROOT="$ROOT"

ME_REGISTRATION="$ROOT/agents/$ME/.dux-amq-source"
FLOCK_BIN="${DUX_AMQ_FLOCK:-flock}"

claim_and_register_locked() {
  local cfg="$ROOT/meta/config.json" marker="$ME_REGISTRATION"
  local agent_dir="$ROOT/agents/$ME" tmp prev current_real prev_real created created_dir=0
  if [[ -e "$agent_dir" || -L "$agent_dir" ]]; then
    [[ -d "$agent_dir" && ! -L "$agent_dir" ]] || return 1
  else
    mkdir "$agent_dir" || return 1
    created_dir=1
  fi
  if [[ -n "${DUX_STORE_ID:-}" ]]; then
    if [[ -e "$marker" || -L "$marker" ]]; then
      if [[ -L "$marker" ]] || ! jq -e --arg store "$DUX_STORE_ID" --arg session "$DUX_SESSION_ID" \
        '.store_id == $store and .session_id == $session' "$marker" >/dev/null 2>&1; then
        printf '[dux-amq] identity collision: %s has a foreign ownership marker\n' "$ME" >&2
        return 1
      fi
    elif (( created_dir == 1 )); then
      tmp=$(mktemp "$agent_dir/.owner.tmp.XXXXXX") || return 1
      if ! jq -cn --arg store "$DUX_STORE_ID" --arg session "$DUX_SESSION_ID" \
        '{store_id:$store,session_id:$session}' >"$tmp" || ! mv "$tmp" "$marker"; then
        rm -f "$tmp"
        return 1
      fi
    else
      printf '[dux-amq] identity collision: %s has an ownerless agent directory\n' "$ME" >&2
      return 1
    fi
  elif [[ -e "$marker" || -L "$marker" ]]; then
    if [[ -L "$marker" ]]; then prev=$(readlink "$marker" 2>/dev/null || true); else prev=$(cat "$marker" 2>/dev/null || true); fi
    current_real=$(realpath -- "$PWD" 2>/dev/null || true)
    prev_real=$(realpath -- "$prev" 2>/dev/null || true)
    if [[ "$prev" != "$PWD" && ( -z "$current_real" || -z "$prev_real" || "$prev_real" != "$current_real" ) ]]; then
      printf '\033[1;31m!\033[0m [dux-amq] identity collision: %s already registered to %s (current: %s).\n' \
        "$ME" "${prev:-<unknown>}" "$PWD" >&2
      return 1
    fi
  elif (( created_dir == 1 )); then
    ln -s "$PWD" "$marker" || return 1
  else
    printf '[dux-amq] identity collision: %s has an ownerless agent directory\n' "$ME" >&2
    return 1
  fi
  tmp=$(mktemp "$ROOT/meta/config.json.tmp.XXXXXX") || return 1
  created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -f "$cfg" ]]; then
    jq --arg me "$ME" '.agents = ((.agents // []) + [$me] | unique)' "$cfg" >"$tmp"
  else
    jq -n --arg me "$ME" --arg created "$created" '{version:1,created_utc:$created,agents:[$me]}' >"$tmp"
  fi
  mv "$tmp" "$cfg"
}

mkdir -p "$ROOT/meta" "$ROOT/agents" || exit 1
command -v "$FLOCK_BIN" >/dev/null 2>&1 || { printf 'gemini-amq: mandatory flock utility is unavailable\n' >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { printf 'gemini-amq: jq is required for atomic AMQ registration\n' >&2; exit 1; }
export ROOT ME ME_REGISTRATION DUX_STORE_ID DUX_SESSION_ID
export -f claim_and_register_locked
"$FLOCK_BIN" -x "$ROOT/meta/config.lock" bash -euo pipefail -c claim_and_register_locked

# Audit02 P0-K (T2) + Phase 13 (audit01 P1-1): route through verify+
# bridge. See claude-amq for the full rationale on TIOCSTI fallback.
LOG_DIR="$HOME/.local/share/dux-amq"
mkdir -p "$LOG_DIR" 2>/dev/null || true
WAKE_LOG="$LOG_DIR/wake-$ME.log"
WAKE_PID="$LOG_DIR/wake-$ME.pid"

LOCAL_BIN="${LOCAL_BIN:-$HOME/.local/bin}"

record_wake_pid_locked() {
  local cfg="$ROOT/meta/config.json" marker="$ME_REGISTRATION" tmp
  jq -e --arg store "$DUX_STORE_ID" --arg session "$DUX_SESSION_ID" \
    '.store_id == $store and .session_id == $session' "$marker" >/dev/null
  jq -e --arg me "$ME" '.agents | index($me) != null' "$cfg" >/dev/null
  tmp=$(mktemp "$ROOT/agents/$ME/.owner.tmp.XXXXXX") || return 1
  if ! jq --argjson pid "$WAKE_PID_VALUE" '.wake_pid = $pid' "$marker" >"$tmp" || ! mv "$tmp" "$marker"; then
    rm -f "$tmp"
    return 1
  fi
}

record_wake_pid() {
  local pid="$1"
  [[ -n "${DUX_STORE_ID:-}" ]] || return 0
  export WAKE_PID_VALUE="$pid"
  export -f record_wake_pid_locked
  "$FLOCK_BIN" -x "$ROOT/meta/config.lock" bash -euo pipefail -c record_wake_pid_locked
}

# Reap a stale wake daemon from a prior invocation for the same $ME.
# See claude-amq for full rationale: without this, re-running the wrapper
# spawns a duplicate daemon causing double-delivery of wake notifications.
reap_stale_wake() {
  [[ -f "$WAKE_PID" ]] || return 0
  local old_pid
  old_pid=$(cat "$WAKE_PID" 2>/dev/null) || return 0
  [[ -z "$old_pid" ]] && return 0
  if kill -0 "$old_pid" 2>/dev/null; then
    local cmdline=""
    if [[ -r "/proc/$old_pid/cmdline" ]]; then
      cmdline=$(tr '\0' ' ' < "/proc/$old_pid/cmdline" 2>/dev/null || true)
    fi
    if [[ "$cmdline" == *amq*wake* ]]; then
      kill "$old_pid" 2>/dev/null || true
      local i=0
      while (( i < 5 )) && kill -0 "$old_pid" 2>/dev/null; do
        sleep 0.1
        (( i++ )) || true
      done
    fi
  fi
  rm -f "$WAKE_PID"
}
reap_stale_wake

INJECT_MODE="${DUX_AMQ_INJECT_MODE:-}"
if [[ -z "$INJECT_MODE" ]]; then
  if [[ -f "$STATE_ROOT/dux/.tiocsti-state" ]]; then
    INJECT_MODE="via"
  else
    INJECT_MODE="raw"
  fi
fi

# Audit02 P1-B: setsid + disown + PID file. See claude-amq for full
# rationale.
case "$INJECT_MODE" in
  raw)
    setsid amq wake --me "$ME" --root "$ROOT" --inject-mode raw \
      </dev/tty >>"$WAKE_LOG" 2>&1 &
    WAKE_CHILD_PID=$!
    disown
    echo "$WAKE_CHILD_PID" > "$WAKE_PID"
    record_wake_pid "$WAKE_CHILD_PID" || { kill "$WAKE_CHILD_PID" 2>/dev/null || true; rm -f "$WAKE_PID"; }
    ;;
  via)
    BRIDGE="$LOCAL_BIN/dux-amq-inject-bridge"
    if [[ ! -x "$BRIDGE" ]]; then
      BRIDGE=$(command -v dux-amq-inject-bridge 2>/dev/null || true)
    fi
    if [[ -n "$BRIDGE" && -x "$BRIDGE" ]]; then
      setsid amq wake --me "$ME" --root "$ROOT" --inject-via "$BRIDGE" \
        >>"$WAKE_LOG" 2>&1 &
      WAKE_CHILD_PID=$!
      disown
      echo "$WAKE_CHILD_PID" > "$WAKE_PID"
      record_wake_pid "$WAKE_CHILD_PID" || { kill "$WAKE_CHILD_PID" 2>/dev/null || true; rm -f "$WAKE_PID"; }
    else
      printf 'gemini-amq: dux-amq-inject-bridge not found; wake disabled\n' >&2
    fi
    ;;
  *)
    printf 'gemini-amq: DUX_AMQ_INJECT_MODE=%q not understood; using raw\n' "$INJECT_MODE" >&2
    setsid amq wake --me "$ME" --root "$ROOT" --inject-mode raw \
      </dev/tty >>"$WAKE_LOG" 2>&1 &
    WAKE_CHILD_PID=$!
    disown
    echo "$WAKE_CHILD_PID" > "$WAKE_PID"
    record_wake_pid "$WAKE_CHILD_PID" || { kill "$WAKE_CHILD_PID" 2>/dev/null || true; rm -f "$WAKE_PID"; }
    ;;
esac

# audit03 Phase 01 §15: per-session system-prompt override.
#
# dux exports DUX_SYSTEM_PROMPT for sessions whose operator set a
# system prompt in the session settings modal. The current Gemini CLI
# (verified against `gemini --help`) does NOT expose a `--append-system-prompt`
# / `--system` / equivalent flag — the documented way to alter the
# system prompt is via `GEMINI.md` files in the workspace, which are
# project-scoped, not per-session. Even passing the text via
# `-i/--prompt-interactive` would land in the user-message stream
# rather than the system-prompt slot, with materially different
# semantics.
#
# Until Gemini CLI grows an explicit per-invocation flag, we warn-and-drop:
# log a single line to stderr so the operator learns their setting was
# a no-op for this provider, and pass nothing to gemini (NEVER pass an
# unsupported flag).
if [[ -n "${DUX_SYSTEM_PROMPT:-}" ]]; then
  printf 'gemini-amq: DUX_SYSTEM_PROMPT set but gemini has no equivalent flag; ignoring\n' >&2
fi

exec amq coop exec --no-wake --no-init --root "$ROOT" --me "$ME" gemini -- "$@"
